<header class="topbar">
  <div class="topbar-left">
    <button class="btn btn-ghost btn-sm menu-toggle" id="menu-toggle" aria-label="Open menu">☰</button>
    <form class="topbar-search" action="/front-desk/reservations" method="get" role="search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" name="search" placeholder="Find reservation, guest or room…" aria-label="Search reservations">
    </form>
  </div>
  <div class="topbar-right">
    <span class="today" id="today"></span>
    <div class="notify-wrap">
      <button type="button" class="notify-bell" id="notify-bell" title="Notifications" aria-label="Notifications" aria-haspopup="true" aria-expanded="false" aria-controls="notify-panel">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
        <span class="notify-count hidden" data-notify-count></span>
      </button>
      <div class="notify-panel hidden" id="notify-panel" role="region" aria-label="Notifications"></div>
    </div>
    <a class="user-chip" href="/account" title="Account settings">
      <div class="avatar" id="avatar">{{currentUser.fullName}}</div>
      <div class="who">{{currentUser.fullName}}<small>{{#if isAdmin}}Administrator{{else}}Receptionist{{/if}}</small></div>
    </a>
    <form method="post" action="/logout">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <button class="btn btn-sm" type="submit">Sign out</button>
    </form>
  </div>
</header>
