{{> head}}
<body>
<div class="auth-form">
  <div class="auth-card card">
    <div class="card-body">
      <p class="muted">Error {{status}}</p>
      <h1>{{title}}</h1>
      <p class="lead">{{message}}</p>
      <div class="row"><a class="btn btn-primary" href="/dashboard">Go to dashboard</a><a class="btn" href="/login">Sign in</a></div>
    </div>
  </div>
</div>
</body>
</html>
