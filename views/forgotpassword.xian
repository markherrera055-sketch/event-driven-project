{{> authStart}}
      <div class="lobby-heading">
        <h1>Forgot password</h1>
        <p class="lead">Staff passwords are managed by your hotel's administrator.</p>
      </div>
      <div class="alert alert-info"><span>Ask an administrator to reset your password from <strong>Admin Console → Staff accounts</strong>.</span></div>
      <a class="btn btn-lg btn-block" href="/login">Back to sign in</a>
{{> authEnd}}
