{
  "info": {
    "name": "Hotel FrontDesk PMS — API v1",
    "description": "Sample requests for the Frontdesk/PMS and the four connected systems.\n\n1. Set the collection variables: baseUrl, and each member's key (bookingApiKey, posApiKey, housekeepingApiKey, hrApiKey) = the values of BOOKING_API_KEY, POS_API_KEY, HOUSEKEEPING_API_KEY, HR_API_KEY in the server's .env. If HOUSEKEEPING_INBOUND_SECRET is set, put it in housekeepingInboundSecret: the Housekeeping folder signs its writes automatically.\n2. Idempotency-Key uses {{$guid}}, so every send is a new operation. To test a network retry, replace it with a fixed value and send twice.\n3. Staff API: run the 'Staff session' requests in order (they store the CSRF token); Postman keeps the session cookie.\nSee docs/INTEGRATIONS.md for every field, response and error code.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Member 1 — Guest Booking System",
      "item": [
        {
          "name": "Room types (ids)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{bookingApiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/integrations/booking/room-types"
          }
        },
        {
          "name": "Availability",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{bookingApiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/integrations/booking/availability?check_in_date={{checkInDate}}&check_out_date={{checkOutDate}}&room_type_id={{roomTypeId}}"
          }
        },
        {
          "name": "Create reservation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{bookingApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_reservation_id\": \"{{externalReservationId}}\",\n  \"guest\": {\n    \"first_name\": \"John\",\n    \"last_name\": \"Doe\",\n    \"email\": \"john@example.com\",\n    \"phone\": \"09123456789\"\n  },\n  \"room_type_id\": {{roomTypeId}},\n  \"check_in_date\": \"{{checkInDate}}\",\n  \"check_out_date\": \"{{checkOutDate}}\",\n  \"number_of_guests\": 2\n}"
            },
            "url": "{{baseUrl}}/api/v1/integrations/booking/reservations"
          }
        },
        {
          "name": "Get reservation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{bookingApiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/integrations/booking/reservations/{{externalReservationId}}"
          }
        },
        {
          "name": "Update reservation",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{bookingApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number_of_guests\": 1,\n  \"payment_status\": \"PREPAID\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/integrations/booking/reservations/{{externalReservationId}}"
          }
        },
        {
          "name": "Cancel reservation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{bookingApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Guest cancelled online\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/integrations/booking/reservations/{{externalReservationId}}/cancel"
          }
        }
      ]
    },
    {
      "name": "Member 4 — Restaurant POS",
      "item": [
        {
          "name": "In-house lookup (get reservation_id)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{posApiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/integrations/pos/in-house?room_number={{roomNumber}}"
          }
        },
        {
          "name": "Charge to room",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{posApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_transaction_id\": \"POS-{{$timestamp}}\",\n  \"room_number\": \"{{roomNumber}}\",\n  \"guest_name\": \"John Doe\",\n  \"reservation_id\": {{reservationId}},\n  \"amount\": 850.00,\n  \"currency\": \"PHP\",\n  \"description\": \"Restaurant Order\",\n  \"items\": [\n    { \"name\": \"Chicken Adobo\", \"quantity\": 2, \"unit_price\": 250.00 },\n    { \"name\": \"Iced Tea\", \"quantity\": 2, \"unit_price\": 175.00 }\n  ],\n  \"transaction_date\": \"{{$isoTimestamp}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/integrations/pos/room-charges"
          }
        },
        {
          "name": "Charge status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{posApiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/integrations/pos/room-charges/{{posTransactionId}}"
          }
        }
      ]
    },
    {
      "name": "Member 3 — Housekeeping System",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Signs writes with HOUSEKEEPING_INBOUND_SECRET: X-Signature = sha256=HMAC_SHA256(secret, `${timestamp}.${rawBody}`)",
              "// Note: do not use dynamic variables like {{$guid}} inside signed bodies (they would differ from what is signed).",
              "const secret = pm.collectionVariables.get('housekeepingInboundSecret');",
              "if (secret && pm.request.method !== 'GET') {",
              "  const ts = Math.floor(Date.now() / 1000).toString();",
              "  const raw = pm.variables.replaceIn((pm.request.body && pm.request.body.raw) || '');",
              "  const sig = 'sha256=' + CryptoJS.HmacSHA256(ts + '.' + raw, secret).toString(CryptoJS.enc.Hex);",
              "  pm.request.headers.upsert({ key: 'X-Timestamp', value: ts });",
              "  pm.request.headers.upsert({ key: 'X-Signature', value: sig });",
              "}"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Room board",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{housekeepingApiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/integrations/housekeeping/rooms?status=DIRTY"
          }
        },
        {
          "name": "One room",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{housekeepingApiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/integrations/housekeeping/rooms/{{roomNumber}}"
          }
        },
        {
          "name": "Register cleaning task (optional)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{housekeepingApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_task_id\": \"{{taskId}}\",\n  \"room_number\": \"{{roomNumber}}\",\n  \"event_id\": \"{{vacatedEventId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/integrations/housekeeping/cleaning-tasks"
          }
        },
        {
          "name": "Cleaning started",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{housekeepingApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_task_id\": \"{{taskId}}\",\n  \"room_number\": \"{{roomNumber}}\",\n  \"started_by\": \"EMP-001\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/integrations/housekeeping/cleaning-started"
          }
        },
        {
          "name": "Cleaning completed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{housekeepingApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_task_id\": \"{{taskId}}\",\n  \"room_number\": \"{{roomNumber}}\",\n  \"status\": \"COMPLETED\",\n  \"completed_by\": \"EMP-001\",\n  \"completed_at\": \"{{completedAt}}\",\n  \"remarks\": \"Room cleaned and inspected\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/integrations/housekeeping/cleaning-completed"
          }
        }
      ]
    },
    {
      "name": "Member 5 — HR and Payroll (read-only)",
      "item": [
        {
          "name": "Completed housekeeping tasks (date range)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{hrApiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/integrations/hr/housekeeping-tasks?from={{checkInDate}}&to={{checkOutDate}}"
          }
        },
        {
          "name": "Verify one task",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{hrApiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/integrations/hr/housekeeping-tasks/{{taskId}}"
          }
        }
      ]
    },
    {
      "name": "Staff session (front desk / admin)",
      "item": [
        {
          "name": "1. Open login page (stores CSRF token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const m = pm.response.text().match(/name=\"_csrf\" value=\"([a-f0-9]+)\"/);",
                  "if (m) pm.collectionVariables.set('csrfToken', m[1]);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/login"
          }
        },
        {
          "name": "2. Sign in",
          "request": {
            "method": "POST",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "_csrf",
                  "value": "{{csrfToken}}"
                },
                {
                  "key": "username",
                  "value": "{{username}}"
                },
                {
                  "key": "password",
                  "value": "{{password}}"
                }
              ]
            },
            "url": "{{baseUrl}}/login"
          }
        },
        {
          "name": "3. Who am I (refreshes CSRF token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('csrfToken', pm.response.json().data.csrfToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/me"
          }
        },
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/dashboard"
          }
        },
        {
          "name": "Today's arrivals",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/reservations?view=arrivals"
          }
        },
        {
          "name": "Reservation by code",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/reservations/RSV-0001"
          }
        },
        {
          "name": "Create walk-in reservation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guest\": { \"firstName\": \"Juan\", \"lastName\": \"Dela Cruz\", \"phone\": \"0917-000-0000\" },\n  \"roomType\": \"Deluxe\",\n  \"checkInDate\": \"{{checkInDate}}\",\n  \"checkOutDate\": \"{{checkOutDate}}\",\n  \"numGuests\": 2\n}"
            },
            "url": "{{baseUrl}}/api/v1/reservations"
          }
        },
        {
          "name": "In-house stays",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/stays"
          }
        },
        {
          "name": "Rooms",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/rooms"
          }
        },
        {
          "name": "Report (last 7 days)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/reports/summary"
          }
        },
        {
          "name": "Guest folio (stay)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/stays/{{stayId}}/folio"
          }
        },
        {
          "name": "Room status history",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/rooms/{{roomId}}/status-history"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "bookingApiKey",
      "value": "change-me"
    },
    {
      "key": "posApiKey",
      "value": "change-me"
    },
    {
      "key": "housekeepingApiKey",
      "value": "change-me"
    },
    {
      "key": "housekeepingInboundSecret",
      "value": ""
    },
    {
      "key": "hrApiKey",
      "value": "change-me"
    },
    {
      "key": "username",
      "value": "frontdesk"
    },
    {
      "key": "password",
      "value": "change-me"
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "externalReservationId",
      "value": "BOOK-10001"
    },
    {
      "key": "roomTypeId",
      "value": "1"
    },
    {
      "key": "checkInDate",
      "value": "2026-12-01"
    },
    {
      "key": "checkOutDate",
      "value": "2026-12-03"
    },
    {
      "key": "reservationId",
      "value": "1"
    },
    {
      "key": "roomNumber",
      "value": "201"
    },
    {
      "key": "roomId",
      "value": "1"
    },
    {
      "key": "stayId",
      "value": "1"
    },
    {
      "key": "posTransactionId",
      "value": "POS-10001"
    },
    {
      "key": "taskId",
      "value": "HK-10001"
    },
    {
      "key": "vacatedEventId",
      "value": ""
    },
    {
      "key": "completedAt",
      "value": "2026-12-03T12:30:00Z"
    }
  ]
}
