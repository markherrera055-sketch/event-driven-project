# Copy to .env and adjust. Never commit the real .env.

NODE_ENV=development
PORT=3000
# Set to true when running behind Nginx / a reverse proxy (deployment diagram)
TRUST_PROXY=false

# Sessions — REQUIRED in production (>= 32 random characters)
SESSION_SECRET=
SESSION_MAX_AGE_MINUTES=720
# true when served over HTTPS
SESSION_SECURE_COOKIE=false

# MySQL 8
DB_HOST=localhost
DB_PORT=3306
DB_NAME=FrontDesk
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# Hotel
HOTEL_NAME=Hotel FrontDesk
HOTEL_TIMEZONE=Asia/Manila
HOTEL_UTC_OFFSET=+08:00
HOTEL_CURRENCY=PHP

# Payment gateway adapter: "sandbox" for development only
PAYMENT_GATEWAY_DRIVER=sandbox
PAYMENT_GATEWAY_TIMEOUT_MS=15000

# ── Integrations with the other hotel systems (docs/INTEGRATIONS.md) ─────────
# Leave a system's API key empty to disable it. Generate keys and secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Give each member ONLY their own key / secrets (over a private channel).
INTEGRATION_RATE_LIMIT_PER_MINUTE=120
INTEGRATION_OUTBOX_INTERVAL_MS=15000
INTEGRATION_OUTBOX_MAX_ATTEMPTS=8
INTEGRATION_WEBHOOK_TIMEOUT_MS=10000
# Refuse plain-HTTP integration calls (defaults to true when NODE_ENV=production)
INTEGRATION_REQUIRE_HTTPS=
# Accepted clock difference for signed requests (replay window), seconds
INTEGRATION_SIGNATURE_TOLERANCE_SECONDS=300
#
# Per system:
#   <SYSTEM>_API_KEY          key the system sends (X-Api-Key) when calling the PMS
#   <SYSTEM>_INBOUND_SECRET   optional: when set, the system must HMAC-sign its writes (X-Timestamp + X-Signature)
#   <SYSTEM>_WEBHOOK_URL      where the PMS POSTs events for this system (empty = no webhooks)
#   <SYSTEM>_WEBHOOK_SECRET   secret the PMS signs those webhooks with (X-PMS-Signature)
#   <SYSTEM>_WEBHOOK_EVENTS   optional comma-separated override of the events it receives

# Member 1 — Guest Booking System (legacy RESERVATION_* names are still read as a fallback)
BOOKING_API_KEY=
BOOKING_INBOUND_SECRET=
BOOKING_WEBHOOK_URL=
BOOKING_WEBHOOK_SECRET=
# StayBook online booking (Member 1's app) uses BOOKING_API_KEY on /api/v1/integrations/staybook.
# StayBook's id for THIS hotel; when set, bookings for other StayBook hotels are refused (docs/STAYBOOK.md).
STAYBOOK_HOTEL_ID=

# Room synchronisation: Frontdesk → OnlineBooking (StayBook) and RoomCare (docs/ROOM_SYNC.md).
# A target is enabled when its URL is set. Nothing is sent until that system's room API contract is
# implemented in integrations/roomSync/adapters.js (until then changes wait as BLOCKED jobs).
STAYBOOK_API_URL=
STAYBOOK_API_TOKEN=
ROOMCARE_API_URL=
ROOMCARE_API_TOKEN=
ROOM_SYNC_INTERVAL_MS=15000
ROOM_SYNC_MAX_ATTEMPTS=8
ROOM_SYNC_TIMEOUT_MS=10000

# Member 3 — Housekeeping System.
# UNVERIFIED ASSUMPTION: RoomCare is treated as this same Housekeeping System, so RoomCare's cleaning
# callbacks and cleaning webhooks use these HOUSEKEEPING_* settings. Member 3 has NOT confirmed this yet;
# do not issue separate RoomCare credentials or rename anything until they do (docs/ROOM_SYNC.md).
HOUSEKEEPING_API_KEY=
# REQUIRED whenever NODE_ENV is not "test": without it every Housekeeping write (cleaning callbacks)
# is refused with 503 INBOUND_SIGNING_NOT_CONFIGURED. Share it with Member 3 over a private channel.
HOUSEKEEPING_INBOUND_SECRET=
HOUSEKEEPING_WEBHOOK_URL=
HOUSEKEEPING_WEBHOOK_SECRET=

# Member 4 — Restaurant POS (purchase notifications for front-desk review: docs/POS_ORDERS.md)
POS_API_KEY=
# Strongly recommended: POS must HMAC-sign its requests (replay protection).
POS_INBOUND_SECRET=
POS_WEBHOOK_URL=
POS_WEBHOOK_SECRET=
# Restaurant / branch ids this hotel accepts purchases from (comma-separated). Empty = any id.
POS_RESTAURANT_IDS=
# Restaurant id used when the POS sends none (single-restaurant hotels). Default MAIN.
POS_DEFAULT_RESTAURANT_ID=

# Member 5 — HR and Payroll (read-only; no webhooks)
HR_API_KEY=

# Optional: initial staff passwords used by `npm run migrate -- --seed`
SEED_ADMIN_PASSWORD=
SEED_RECEPTIONIST_PASSWORD=
